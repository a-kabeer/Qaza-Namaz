{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qaza-namaz.local/schemas/knowledge-base-content.schema.json",
  "title": "Qaza Namaz Knowledge Base Content",
  "description": "One language file of the Masail/Mugalat content. The English and Urdu files share every non-language field and are joined on id at load time.",
  "type": "array",
  "items": {
    "$ref": "#/$defs/entry"
  },
  "$defs": {
    "entry": {
      "type": "object",
      "required": ["id", "type", "categoryId", "references", "sortOrder", "isPublished"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "type": {"enum": ["masala", "mugalata"]},
        "categoryId": {"type": "string", "minLength": 1},
        "sortOrder": {"type": "integer", "minimum": 0},
        "isPublished": {"type": "boolean"},
        "titleEn": {"$ref": "#/$defs/text"},
        "questionEn": {"$ref": "#/$defs/text"},
        "summaryEn": {"$ref": "#/$defs/text"},
        "contentEn": {"$ref": "#/$defs/text"},
        "keywordsEn": {"$ref": "#/$defs/keywords"},
        "titleUr": {"$ref": "#/$defs/text"},
        "questionUr": {"$ref": "#/$defs/text"},
        "summaryUr": {"$ref": "#/$defs/text"},
        "contentUr": {"$ref": "#/$defs/text"},
        "keywordsUr": {"$ref": "#/$defs/keywords"},
        "references": {
          "type": "array",
          "items": {"$ref": "#/$defs/reference"}
        }
      },
      "oneOf": [
        {
          "required": ["titleEn", "questionEn", "summaryEn", "contentEn", "keywordsEn"],
          "not": {"required": ["titleUr"]}
        },
        {
          "required": ["titleUr", "questionUr", "summaryUr", "contentUr", "keywordsUr"],
          "not": {"required": ["titleEn"]}
        }
      ]
    },
    "text": {"type": "string", "minLength": 1},
    "keywords": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceName", "bookName", "author"],
      "properties": {
        "sourceName": {"type": "string", "minLength": 1},
        "bookName": {"type": "string", "minLength": 1},
        "author": {"type": "string", "minLength": 1}
      }
    }
  }
}
