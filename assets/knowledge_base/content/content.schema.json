{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qaza-namaz.local/schemas/knowledge-base-content.schema.json",
  "title": "Qaza Namaz Knowledge Base Content",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "articles"],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "articles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/article"
      }
    }
  },
  "$defs": {
    "localizedText": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ur", "en"],
      "properties": {
        "ur": {"type": "string", "minLength": 1},
        "en": {"type": "string", "minLength": 1}
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "citation": {"type": ["string", "null"], "minLength": 1},
        "url": {"type": ["string", "null"], "format": "uri"}
      }
    },
    "article": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "slug",
        "category",
        "sortOrder",
        "title",
        "summary",
        "body",
        "tags",
        "references",
        "relatedArticleIds"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "minLength": 3,
          "maxLength": 80
        },
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "minLength": 3,
          "maxLength": 120
        },
        "category": {
          "type": "string",
          "enum": ["masail", "mugalat"]
        },
        "sortOrder": {
          "type": "integer",
          "minimum": 0
        },
        "title": {
          "$ref": "#/$defs/localizedText"
        },
        "summary": {
          "$ref": "#/$defs/localizedText"
        },
        "body": {
          "$ref": "#/$defs/localizedText"
        },
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          }
        },
        "references": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reference"
          }
        },
        "relatedArticleIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "minLength": 3,
            "maxLength": 80
          }
        }
      }
    }
  }
}
