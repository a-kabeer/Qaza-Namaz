rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function resetInProgress(userId) {
      return exists(
        /databases/$(database)/documents/users/$(userId)/syncMetadata/state
      )
      && get(
        /databases/$(database)/documents/users/$(userId)/syncMetadata/state
      ).data.resetInProgress == true;
    }

    function validQazaRecord(data, userId, recordId) {
      return data.keys().hasOnly([
        'id',
        'userId',
        'operationId',
        'prayerType',
        'originalDate',
        'status',
        'completedAt',
        'completionId',
        'createdAt',
        'updatedAt',
        'syncGeneration'
      ])
      && data.id is string
      && data.id.size() > 0
      && data.id.size() <= 128
      && data.id == recordId
      && data.userId is string
      && data.userId == userId
      && data.prayerType in [
        'fajr',
        'zuhr',
        'asr',
        'maghrib',
        'isha',
        'witr'
      ]
      && data.originalDate is string
      && data.originalDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
      && (
        !data.keys().hasAny(['operationId'])
        || data.operationId == null
        || (data.operationId is string && data.operationId.size() > 0 && data.operationId.size() <= 128)
      )
      && data.status in ['pending', 'completed', 'deleted']
      && (
        (data.status == 'pending'
          && data.completedAt == null
          && (!data.keys().hasAny(['completionId']) || data.completionId == null))
        || (data.status == 'completed'
          && data.completedAt is timestamp
          && (!data.keys().hasAny(['completionId'])
            || data.completionId == null
            || (data.completionId is string
              && data.completionId.size() > 0
              && data.completionId.size() <= 256)))
        || (data.status == 'deleted'
          && (data.completedAt == null || data.completedAt is timestamp)
          && (!data.keys().hasAny(['completionId'])
            || data.completionId == null
            || (data.completionId is string
              && data.completionId.size() > 0
              && data.completionId.size() <= 256)))
      )
      && data.createdAt is timestamp
      && data.updatedAt is timestamp
      && data.syncGeneration is int
      && data.syncGeneration >= 0;
    }

    function validSyncState(data) {
      return data.keys().hasOnly([
        'generation',
        'resetInProgress',
        'resetOperationId',
        'lastCompletedResetOperationId'
      ])
      && data.generation is int
      && data.generation >= 0
      && data.resetInProgress is bool
      && (
        !data.keys().hasAny(['resetOperationId'])
        || data.resetOperationId == null
        || data.resetOperationId is string
      )
      && (
        !data.keys().hasAny(['lastCompletedResetOperationId'])
        || data.lastCompletedResetOperationId == null
        || data.lastCompletedResetOperationId is string
      )
      && (
        (!data.resetInProgress
          && (
            !data.keys().hasAny(['resetOperationId'])
            || data.resetOperationId == null
          ))
        || (data.resetInProgress
          && data.keys().hasAny(['resetOperationId'])
          && data.resetOperationId is string
          && data.resetOperationId.size() > 0)
      );
    }

    function validSyncStateTransition(before, after) {
      return validSyncState(after)
      && (
        // Ordinary sync writes keep the current generation.
        after.generation == before.generation
        // A reset may advance the generation exactly once and must enter
        // the explicit in-progress state with an operation id.
        || (
          !before.resetInProgress
          && after.generation == before.generation + 1
          && after.resetInProgress == true
        )
      )
      && (
        // Completing a reset must preserve the generation and bind the
        // completion marker to the operation that started it.
        !before.resetInProgress
        || (
          after.generation == before.generation
          && after.resetInProgress == false
          && after.keys().hasAny(['lastCompletedResetOperationId'])
          && after.lastCompletedResetOperationId
            == before.resetOperationId
          && (!after.keys().hasAny(['resetOperationId'])
              || after.resetOperationId == null)
        )
      );
    }

    function validChange(data, userId) {
      return data.keys().hasOnly([
        'changeType',
        'generation',
        'createdAt',
        'records',
        'recordIds'
      ])
      && data.changeType in ['upsert', 'update', 'complete', 'delete', 'reset']
      && data.generation is int
      && data.generation >= 0
      && data.createdAt is timestamp
      && data.records is list
      && data.records.size() <= 400
      && data.recordIds is list
      && data.recordIds.size() <= 400
      && (
        (data.changeType == 'reset' && data.records.size() == 0 && data.recordIds.size() == 0)
        || (data.changeType == 'delete' && (data.records.size() + data.recordIds.size()) > 0)
        || (data.changeType != 'delete' && data.changeType != 'reset' && data.records.size() > 0)
      )
      && data.generation
        == getAfter(
          /databases/$(database)/documents/users/$(userId)/syncMetadata/state
        ).data.generation
      && getAfter(
        /databases/$(database)/documents/users/$(userId)/syncMetadata/state
      ).data.resetInProgress == false;
    }

    match /users/{userId}/qazaRecords/{recordId} {
      allow read: if isOwner(userId);

      allow create: if isOwner(userId)
        && !resetInProgress(userId)
        && validQazaRecord(request.resource.data, userId, recordId)
        && request.resource.data.syncGeneration
          == getAfter(
            /databases/$(database)/documents/users/$(userId)/syncMetadata/state
          ).data.generation;

      allow update: if isOwner(userId)
        && !resetInProgress(userId)
        && validQazaRecord(request.resource.data, userId, recordId)
        && request.resource.data.syncGeneration
          == resource.data.syncGeneration
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.id == resource.data.id
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt >= resource.data.updatedAt
        && (
            (
              resource.data.status == 'pending'
              && request.resource.data.status in ['pending', 'completed', 'deleted']
            )
            || (
              resource.data.status == 'completed'
              && request.resource.data.status == 'pending'
              && request.resource.data.completedAt == null
              && request.resource.data.updatedAt > resource.data.updatedAt
            )
            || (
              resource.data.status == 'completed'
              && request.resource.data.status == 'deleted'
              && request.resource.data.completedAt == resource.data.completedAt
              && request.resource.data.updatedAt > resource.data.updatedAt
            )
            || (
              resource.data.status == 'completed'
              && request.resource.data.status == 'completed'
              && request.resource.data.completedAt == resource.data.completedAt
            )
            || (
              resource.data.status == 'deleted'
              && request.resource.data.status in ['deleted', 'pending', 'completed']
              && request.resource.data.updatedAt > resource.data.updatedAt
              && (
                (request.resource.data.status == 'pending' && request.resource.data.completedAt == null)
                || (request.resource.data.status == 'completed' && request.resource.data.completedAt is timestamp)
                || (request.resource.data.status == 'deleted' && request.resource.data.completedAt == resource.data.completedAt)
              )
            )
          )
        && request.resource.data.syncGeneration
          == getAfter(
            /databases/$(database)/documents/users/$(userId)/syncMetadata/state
          ).data.generation;

      allow delete: if isOwner(userId);
    }

    match /users/{userId}/qazaChanges/{changeId} {
      allow read: if isOwner(userId);

      allow create: if isOwner(userId)
        && changeId.size() > 0
        && changeId.size() <= 256
        && validChange(request.resource.data, userId);

      // The owner may explicitly purge their cloud change log. This is used
      // only by the Account Data Transparency cloud-deletion flow.
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/syncMetadata/{documentId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && documentId == 'state'
        && validSyncState(request.resource.data);

      allow update: if isOwner(userId)
        && documentId == 'state'
        && validSyncStateTransition(
          resource.data,
          request.resource.data
        );
      allow delete: if isOwner(userId)
        && documentId == 'state';
    }
  }
}
