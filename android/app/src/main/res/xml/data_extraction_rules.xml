<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <include
            domain="database"
            path="qaza_namaz.sqlite" />
    </cloud-backup>
    <device-transfer>
        <!-- Do not silently transfer the local Qaza ledger to another device.
             Account sync or an explicit export/import is the recovery path. -->
        <exclude domain="database" path="qaza_namaz.sqlite" />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
