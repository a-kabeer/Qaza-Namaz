# Copy to android/key.properties and fill in with your own keystore.
#
# android/key.properties is git-ignored and must never be committed: it holds
# the passwords to your release signing key.
#
# Create the keystore yourself — it is not generated by the build, and it must
# not be generated by anyone else. Losing it means you can no longer publish an
# update to an app already on the Play Store under the same key, so back it up
# somewhere durable and private:
#
#   keytool -genkey -v \
#     -keystore ~/qaza-namaz-release.jks \
#     -keyalg RSA -keysize 2048 -validity 10000 \
#     -alias qaza-namaz
#
# storeFile is resolved relative to android/app/, so an absolute path is
# usually clearest.

storeFile=/absolute/path/to/qaza-namaz-release.jks
storePassword=
keyAlias=qaza-namaz
keyPassword=
